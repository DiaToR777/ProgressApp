<UserControl x:Class="ProgressApp.WpfUI.Views.Goal.GoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ProgressApp.WpfUI.Converters"
             xmlns:helpers="clr-namespace:ProgressApp.WpfUI.Localization.Helpers"
             TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  helpers:LanguageHelper.UpdateLanguage="{Binding Source={StaticResource Langs}, Path=CurrentCulture}">
        <StackPanel Margin="20" Width="500">

            <ui:TextBlock Text="{Binding Source={StaticResource Langs}, Path=[Title_MyGoal]}"
                          FontWeight="Bold" FontSize="28" Margin="0,0,0,20"/>
            
            <ui:Card Padding="15" Margin="0,0,0,15"
                     DataContext="{Binding Completion}"
                     Visibility="{Binding IsMilestoneExpired, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ui:TextBlock Text="{Binding Source={StaticResource Langs}, Path=[Title_MilestoneFinished]}"
                                  FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>

                    <ui:TextBlock Appearance="Secondary" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10">
                        <Run Text="{Binding Source={StaticResource Langs}, Path=[Title_ExecutionStability], Mode=OneWay}" />
                        <Run Text=": " />
                        <Run Text="{Binding Progress.ConsistencyPercent, Mode=OneWay, StringFormat={}{0}%}" />
                    </ui:TextBlock>

                    <ui:TextBlock Text="{Binding Source={StaticResource Langs}, Path=[Hint_SuggestSuccess]}"
                                  Appearance="Secondary" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                                  Visibility="{Binding SuggestsSuccess, Converter={StaticResource BoolToVis}}"/>
                    <ui:TextBlock Text="{Binding Source={StaticResource Langs}, Path=[Hint_SuggestFail]}"
                                  Appearance="Secondary" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                                  Visibility="{Binding SuggestsFail, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Content="{Binding Source={StaticResource Langs}, Path=[Btn_Achieved]}"
                                   Command="{Binding CompleteSuccessCommand}"
                                   Appearance="Primary"/>
                        <ui:Button Content="{Binding Source={StaticResource Langs}, Path=[Btn_NotAchieved]}"
                                   Command="{Binding CompleteFailCommand}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox Value="{Binding ExtendDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="1" Maximum="365"
                                      MinWidth="80"
                                      HorizontalAlignment="Left"/>
                        <ui:Button Content="{Binding Source={StaticResource Langs}, Path=[Btn_ExtendMilestone]}"
                                   Command="{Binding ExtendMilestoneCommand}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsNotEditingGoal, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="{Binding ActiveGoal.Title}" FontWeight="Medium" FontSize="18"/>
                                <ui:TextBlock Text="{Binding ActiveGoal.Description}"
                                              Appearance="Secondary" FontSize="13" Margin="0,6,0,0"
                                              TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="✎" Command="{Binding StartEditGoalCommand}" VerticalAlignment="Top"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsEditingGoal, Converter={StaticResource BoolToVis}}">
                        <ui:TextBox Text="{Binding EditGoalTitle, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding Source={StaticResource Langs}, Path=[Title_YourGoal]}" Margin="0,0,0,8"/>
                        <ui:TextBox Text="{Binding EditGoalDescription, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                    PlaceholderText="{Binding Source={StaticResource Langs}, Path=[Title_GoalDescription]}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{Binding Source={StaticResource Langs}, Path=[Btn_Save]}" Command="{Binding SaveGoalCommand}" Appearance="Primary"/>
                            <ui:Button Content="{Binding Source={StaticResource Langs}, Path=[Btn_Cancel]}" Command="{Binding CancelEditGoalCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="15" Margin="0,0,0,15">
                <StackPanel Margin="0,0,0,10">
                    <ui:TextBlock Appearance="Secondary" FontSize="12">
                        <Run Text="{Binding MilestoneProgress.DaysElapsed, Mode=OneWay}" />
                        <Run Text="/" />
                        <Run Text="{Binding MilestoneProgress.TargetDays, Mode=OneWay}" />
                        <Run Text="{Binding Source={StaticResource Langs}, Path=[Title_days], Mode=OneWay}" />
                    </ui:TextBlock>
                    <ProgressBar Value="{Binding MilestoneProgress.DaysCompletionPercent}" Maximum="100" Height="6"
                                 Margin="0,4,0,12" />

                    <ui:TextBlock Text="{Binding Source={StaticResource Langs}, Path=[Title_ExecutionStability]}" Appearance="Secondary" FontSize="12" />
                    <ProgressBar Value="{Binding MilestoneProgress.ConsistencyPercent}" Maximum="100" Height="6"
                                 Margin="0,4,0,0" />
                    <ui:TextBlock Text="{Binding MilestoneProgress.ConsistencyPercent, StringFormat={}{0}%}" FontSize="12"
                                  Appearance="Secondary" HorizontalAlignment="Right" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="15" DataContext="{Binding Actions}">
                <StackPanel>
                    <ui:TextBlock Text="{Binding Source={StaticResource Langs}, Path=[Title_Actions]}" Appearance="Secondary" FontSize="12" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:TextBox Text="{Binding NewActionTitle, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding Source={StaticResource Langs}, Path=[Placeholder_ActionName]}"
                                    Width="220"/>
                        <ui:NumberBox Value="{Binding NewActionTargetCountPerWeek, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="1"
                                      Maximum="7"
                                      MinWidth="80"
                                      HorizontalAlignment="Left"
                                         Margin="8,0,0,0"/>
                        <ui:Button Content="{Binding Source={StaticResource Langs}, Path=[Btn_Save]}"
                                   Command="{Binding SaveActionCommand}"
                                   Margin="8,0,0,0"/>
                        <ui:Button Content="{Binding Source={StaticResource Langs}, Path=[Btn_Cancel]}"
                                   Command="{Binding CancelEditActionCommand}"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                            <Run Text="{Binding Title}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding TargetCountPerWeek}"/>
                                            <Run Text="{Binding Source={StaticResource Langs}, Path=[Title_/wk], Mode=OneWay}"/>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <!-- ВАЖНО: ищем DataContext у ItemsControl (там GoalActionsViewModel),
                                                 а не у UserControl (там родительский GoalViewModel) -->
                                            <ui:Button Content="✎"
                                                       Command="{Binding DataContext.StartEditActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       Margin="8,0,0,0"/>
                                            <ui:Button Content="✕"
                                                       Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
